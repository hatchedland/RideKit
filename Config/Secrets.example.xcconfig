// Copy this file to Config/Secrets.xcconfig (git-ignored) and paste your key.
// Google Cloud Console › Google Maps Platform › Keys: an iOS key restricted to the bundle ID
// com.hatchedland.ridetracker, with only "Maps SDK for iOS" enabled.
GMS_API_KEY = YOUR_KEY_HERE
// Supabase › Project Settings › API: the project's host (no https://, xcconfig would cut it at "//")
// and its publishable key (sb_publishable_…, safe to ship in the app).
SUPABASE_HOST = YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY
